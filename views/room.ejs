<!DOCTYPE html>
<html lang="ja">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <%- include("partials/header") %>
    <title><%= room.name %>
    </title>
    <link rel="stylesheet" href="/room.css">
</head>

<body>
    <%- include("partials/navbar") %>
    <%- include("partials/icon") %>
    <div class="container py-4">
        <div class="card shadow-sm mx-auto" style="max-width: 600px;">
            <div class="card-body text-center p-4">

                <h1 class="fw-bold mb-2">
                    <%= room.name %>
                </h1>
                <p class="text-muted mb-4">
                    <span id="playersCount"><%= room.players.length %></span>/<%= room.maxSockets %>人がプレイ中
                </p>

                <div id="turns" class="mb-3">
                </div>

                <button class="btn btn-primary btn-lg mb-4" id="joinBtn">
                    ゲームに参加
                </button>

                <div class="alert alert-danger" id="errorBox" style="display:none;"></div>
                <div class="alert alert-info" id="infoBox" style="display:none;"></div>
                <div class="alert alert-warning" id="warnBox" style="display:none;"></div>


                <div id="turnDiv" class="border rounded p-3 turn-other mb-4">
                    <div class="text-secondary mb-2">現在の単語</div>
                    <div class="fs-3 fw-bold">
                        <span id="latest">
                            <%= room.latestWord() %>
                        </span>
                    </div>
                    <div class="fs-4 text-muted">↓</div>
                </div>

                <form id="form" class="d-flex gap-2 mb-4">
                    <input id="msg" type="text" class="form-control" placeholder="単語を入力" maxlength="25" disabled>
                    <button id="sendBtn" class="btn btn-success px-2" style="width: 4em;" disabled>
                        送信
                    </button>
                </form>

                <p id="wordHistory" class="fs-5 fw-semibold text-primary mb-0 history"></p>

                <button id="resetBtn" class="btn btn-danger" hidden>履歴をリセットする</button>

            </div>
        </div>
    </div>

    <script src="https://cdn.socket.io/4.8.3/socket.io.min.js"></script>
    <%- include("partials/footer") %>
    <script>
        window.roomId = "<%= id %>";
    </script>

    <script src="/room.js"></script>
</body>

</html>