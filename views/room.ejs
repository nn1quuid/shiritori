<!DOCTYPE html>
<html lang="ja">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=M+PLUS+1:wght@100..900&family=Ubuntu+Sans:ital,wght@0,100..800;1,100..800&display=swap"
        rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <title>ルーム<%= id %>
    </title>
    <style>
        body {
            font-family: "ubuntu sans", "m plus 1", sans-serif;
        }

        .col {
            max-width: max(20%, 20rem);
        }

        .history{
            height: 5em;
            overflow-y: auto;
        }

        /* turn */
        .turn-you{
            background-color: #ddffe0;
        }
        .turn-other{
            background-color: #ededed;
        }

        /* latest */
        #latest {
            display: inline-block;
            transition:
                opacity 0.15s ease,
                transform 0.15s ease;
        }

        #latest.changing {
            opacity: 0;
            transform: translateY(-4px);
        }

        .bnto-user {
            position: fixed;
            top: 15px;
            right: 15px;
            z-index: 1000;

            --c1: lightgray;
            --dur: .15s;
            display: inline-block;
        }

        /* 丸アバターボタン */
        .bnto-user-btn {
            width: 46px;
            height: 46px;
            border-radius: 50%;
            border: 3px solid #fff;
            background: var(--c1);
            color: #fff;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            box-shadow: 0 5px 14px rgba(0, 0, 0, .16);
        }

        .bnto-user-menu {
            position: absolute;
            top: calc(100% + 10px);
            right: 0;
            min-width: 200px;
            z-index: 5;
            background: #fff;
            border: 2px solid #DFE9F1;
            border-radius: 12px;
            padding: 6px;
            box-shadow: 0 12px 28px rgba(0, 0, 0, .12);
            opacity: 0;
            visibility: hidden;
            transform: translateY(-6px);
            transition: opacity var(--dur), transform var(--dur), visibility var(--dur);
        }

        .bnto-user.is-open .bnto-user-menu {
            opacity: 1;
            visibility: visible;
            transform: none;
        }

        /* ユーザー情報ヘッダー */
        .bnto-user-menu .who {
            padding: 8px 12px 10px;
            border-bottom: 2px dashed #DFE9F1;
            margin-bottom: 4px;
        }

        .bnto-user-menu .who b {
            display: block;
        }

        .bnto-user-menu .who span {
            font-size: 11px;
            color: #9a948a;
        }

        .bnto-user-menu a {
            display: flex;
            align-items: center;
            gap: 9px;
            padding: 9px 12px;
            border-radius: 8px;
            color: inherit;
            text-decoration: none;
            font-weight: 700;
        }

        .bnto-user-menu a:hover {
            background: #EAF2F8;
        }

        .bnto-user-menu .sep {
            border-top: 2px dashed #DFE9F1;
            margin: 4px 0;
        }

        .bnto-user-menu .out {
            color: hsl(4 75% 52%);
        }

        .bnto-user-menu .out:hover {
            background: hsl(4 75% 96%);
        }
    </style>
</head>

<body>
    <%- include("partials/icon") %>
    <div class="container py-5">
        <div class="card shadow-sm mx-auto" style="max-width: 600px;">
            <div class="card-body text-center p-4">

                <h1 class="fw-bold mb-2">
                    <%= room.name %>
                </h1>
                <p class="text-muted mb-4">
                    <span id="playersCount"><%= room.players.length %></span>/<%= room.maxSockets %>人がプレイ中
                </p>

                <div id="turns" class="mb-3">
                </div>

                <button class="btn btn-primary btn-lg mb-4" id="joinBtn">
                    ゲームに参加
                </button>

                <div class="alert alert-danger" id="errorBox" style="display:none;"></div>
                <div class="alert alert-info" id="infoBox" style="display:none;"></div>
                <div class="alert alert-warning" id="warnBox" style="display:none;"></div>


                <div id="turnDiv" class="border rounded p-3 turn-other mb-4">
                    <div id="turns" class="fs-5 fw-bold text-primary mb-3">
                    </div>
                    <div class="text-secondary mb-2">現在の単語</div>
                    <div class="fs-3 fw-bold">
                        <span id="latest">
                            <%= room.latestWord() %>
                        </span>
                    </div>
                    <div class="fs-4 text-muted">↓</div>
                </div>

                <form id="form" class="d-flex gap-2 mb-4">
                    <input id="msg" type="text" class="form-control" placeholder="単語を入力" maxlength="25" disabled>
                    <button id="sendBtn" class="btn btn-success px-2" style="width: 4em;" disabled>
                        送信
                    </button>
                </form>

                <p id="wordHistory" class="fs-5 fw-semibold text-primary mb-0 history"></p>

            </div>
        </div>
    </div>

    <script src="https://cdn.socket.io/4.8.3/socket.io.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
    <script>
        (async () => {
            const roomId = "<%= id %>";
            const playerId = localStorage.getItem("pid");
            if (!playerId) {
                location.href = "/";
                return
            }
            const fd = new FormData();
            fd.append("pid", playerId);
            const response = await fetch("/api/pid", {
                method: "POST",
                body: new URLSearchParams(fd)
            })
            const res = await response.json();

            if (!res.ok) {
                location.href = "/";
                return
            }

            const player = res.player;

            // --- user icon ---
            document.getElementById("who").innerText = player.displayName;
            document.getElementById("whoid").innerText = "@" + player.id;
            const userMenu = document.querySelector(".bnto-user");
            let theme = player.themeColor;
            userMenu.style.setProperty("--c1", theme);
            // --- ---

            const socket = io();
            const errorBox = document.getElementById("errorBox");
            const infoBox = document.getElementById("infoBox");
            const warnBox = document.getElementById("warnBox");
            const wordInput = document.getElementById("msg");
            const playersCount=document.getElementById("playersCount");
            const wordHistory=document.getElementById("wordHistory")

            wordInput.disabled = true;
            wordInput.addEventListener("input",()=>{
                warnBox.style.display="none";
            })

            socket.emit("room:join-spectator", { roomId, playerId }); // not in game

            // --- join game ---
            const joinBtn = document.getElementById("joinBtn");
            joinBtn.addEventListener("click", joinGame);

            const sendBtn = document.getElementById("sendBtn");
            function joinGame() {
                joinBtn.disabled=true;
                socket.emit("room:join-player", { roomId, playerId });
                socket.once("room:join-accept", ()=>{
                    wordInput.disabled = false;
                    sendBtn.disabled = false;
                    joinBtn.style.display = "none";
                })
            }

            function getCurrentTimeLabel() {
                const now = new Date();
                const hh = String(now.getHours()).padStart(2, "0");
                const mm = String(now.getMinutes()).padStart(2, "0");
                return `[${hh}:${mm}]`;
            }

            function turnChange(cmd) {
                const elem=document.getElementById("turnDiv");
                if (cmd=="you"){
                    elem.classList.replace("turn-other", "turn-you");
                    return
                }
                if (cmd=="other"){
                    elem.classList.replace("turn-you", "turn-other");
                    return
                }

                // if cmd == undefined
                if (elem.classList.contains("turn-you")) {
                    elem.classList.replace("turn-you", "turn-other");
                } else if (elem.classList.contains("turn-other")) {
                    elem.classList.replace("turn-other", "turn-you");
                }
            }

            function newInfo(infoMsg){
                const existingInfos = infoBox.innerText.split("\n");
                if (existingInfos.length > 3) {
                    existingInfos.shift();
                    infoBox.innerText = existingInfos.join("\n");
                }
                const t=getCurrentTimeLabel();
                infoBox.style.display = "";
                infoBox.innerText += `${t} ${infoMsg}\n`;
            }
            socket.on("info", (msg) => {
                newInfo(msg);
            })
            socket.on("error", (msg) => {
                errorBox.style.display = "";
                errorBox.textContent += msg;
                errorBox.innerHTML += "<br><a href='/'>TOPへ戻る</a>";
                wordInput.remove();
                sendBtn.remove();
                joinBtn.remove();
            })
            socket.on("warn", (msg) => {
                warnBox.style.display = "";
                warnBox.textContent = msg;
            })

            window.addEventListener("beforeunload", () => {
                socket.emit("room:leave", { roomId, playerId });
            })

            socket.on("game:addHistory", (msg) => {
                wordHistory.innerText += msg + "\n";
                wordHistory.scrollTop=wordHistory.scrollHeight;

            })
            const form = document.getElementById("form");

            form.addEventListener("submit", (e) => {
                e.preventDefault();
                const msg = wordInput.value.trim();
                if (msg.length<=25 && /^[ぁ-んァ-ヶー]+$/.test(msg)){
                    socket.emit("game:submit", { roomId, playerId, msg });
                } else {
                    warnBox.style.display="";
                    warnBox.textContent="このワードは使用できません。";
                }
                wordInput.value = "";
                wordInput.focus();
            })

            // change latest
            const latest = document.getElementById("latest");
            function changeLatest(word) {
                latest.classList.add("changing");

                setTimeout(() => {
                    latest.textContent = word;
                    latest.classList.remove("changing");
                }, 150);
            }
            socket.on("updateLatest", (word) => {
                if (!word) {
                    return
                }
                changeLatest(word);
            })

            socket.on("game:not-your-turn",()=>{
                turnChange("other");
            })
            socket.on("game:your-turn",()=>{
                turnChange("you");
            })

            socket.on("game:update-playerData", (gameData)=>{
                playersCount.textContent=gameData.playerNames.length;

                const turns = document.getElementById("turns");
                turns.replaceChildren();
                gameData.playerNames.forEach((playerName, index) => {
                    const span = document.createElement("span");

                    span.textContent = playerName;
                    span.className = index === gameData.ctpIndex
                        ? "fw-bold text-primary"
                        : "text-secondary";

                    turns.appendChild(span);
                    if (index < gameData.playerNames.length - 1) {
                        turns.appendChild(document.createTextNode("→"));
                    }
                });
            })

            socket.on("disconnect", ()=>{
                warnBox.style.display="";
                warnBox.textContent="切断されました。";
            })
        })();
    </script>
    <script>
        (function () {
            document.querySelectorAll('[data-bnto-usermenu]').forEach(function (um) {
                if (um.dataset.bntoInit) return;
                um.dataset.bntoInit = '1';
                var btn = um.querySelector('.bnto-user-btn');
                btn.setAttribute('aria-haspopup', 'true');
                btn.setAttribute('aria-expanded', 'false');
                btn.addEventListener('click', function () {
                    var open = um.classList.toggle('is-open');
                    btn.setAttribute('aria-expanded', open);
                });
                um.querySelectorAll('.bnto-user-menu a').forEach(function (item) {
                    item.addEventListener('click', function () {
                        um.classList.remove('is-open');
                        btn.setAttribute('aria-expanded', 'false');
                    });
                });
            });
            if (document.documentElement.dataset.bntoUserDoc) return;
            document.documentElement.dataset.bntoUserDoc = '1';
            function closeAll(except) {
                document.querySelectorAll('[data-bnto-usermenu].is-open').forEach(function (um) {
                    if (um === except) return;
                    um.classList.remove('is-open');
                    um.querySelector('.bnto-user-btn').setAttribute('aria-expanded', 'false');
                });
            }
            document.addEventListener('click', function (e) {
                closeAll(e.target.closest('[data-bnto-usermenu]'));
            });
            document.addEventListener('keydown', function (e) {
                if (e.key === 'Escape') closeAll(null);
            });
        })();
    </script>
</body>

</html>