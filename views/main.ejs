<!DOCTYPE html>
<html lang="ja">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>しりとりゲーム</title>
  <%- include("partials/header") %>
  <style>
    body {
      font-family: "ubuntu sans", "M PLUS 1", sans-serif;
      letter-spacing: 0.05rem;
    }

    .bnto-head-sideline {
      display: flex;
      align-items: center;
      gap: 16px;
    }

    .bnto-head-sideline::before,
    .bnto-head-sideline::after {
      content: "";
      flex: 1;
      height: 2px;
      border-radius: 2px;
      background: hsl(30 12% 15%);
    }

    .info-msg {
      max-width: 25rem;
    }
  </style>
</head>

<body>
  <%- include("partials/navbar") %>
  <%- include("partials/icon") %>
  <h1 class="bnto-head-sideline mt-3 mb-5">しりとりゲーム</h1>
  
  <div class="text-center mt-3">
    <div class="d-flex flex-column align-items-center">

      <div class="alert alert-info info-msg">
        <span id="displayName"></span> さん、しりとりを始めましょう！
      </div>

      <h2 class="bnto-head-sideline mt-3 mb-2">ルール</h2>
      最後の文字が、<br>
      伸ばし棒の時は、直前の文字の母音から続けます。<br>
      小さい文字の時は、大きくします。<br>
      たとえば、<br>
      「かれー」の次は「え」から始まる単語です。<br>
      「かいしゃ」の次は「や」から始まる単語です。<br>
      <div>
        <button class="btn btn-success rounded-pill px-3 my-5 mx-3" id="gameBtn" autofocus disabled>CPU対戦</button>
        <button class="btn btn-secondary rounded-pill px-3 my-5 mx-3" id="pvp" autofocus disabled>Coming Soon…</button>
      </div>
    </div>

  </div>
  <%- include("partials/footer") %>
  <script>
    // elements
    const gameBtn = document.getElementById("gameBtn");
    const pvpBtn = document.getElementById("pvp");
    const nameDisplay = document.getElementById("displayName");

    window.addEventListener("DOMContentLoaded", async () => {
      const playerId = localStorage.getItem("pid") ?? undefined;
      if (!playerId){
        location.href="/";
        return
      }
      let pidFD = new FormData();
      pidFD.append("pid", playerId);

      const response = await fetch("/api/pid", {
        method: "POST",
        body: new URLSearchParams(pidFD)
      })
      const result = await response.json();
      if (!result.ok) {
        location.href = "/";
        return;
      }
      if (result.ok) {
        document.getElementById("who").textContent = result.player.displayName;
        document.getElementById("whoid").textContent = "@" + result.player.id;
        const userMenu = document.querySelector(".bnto-user");
        let theme = result.player.themeColor;
        userMenu.style.setProperty("--c1", theme);
        nameDisplay.textContent = result.player.displayName;

        gameBtn.onclick = () => {
          location.href = `/cpu?pid=${encodeURIComponent(playerId)}`;
        };
        pvpBtn.onclick = () => {
          location.href = `/rooms`;
        };
        gameBtn.disabled = false;
        pvpBtn.disabled = false;
        gameBtn.focus();
      }
    })

  </script>
</body>

</html>