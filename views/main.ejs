<!DOCTYPE html>
<html lang="ja">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>しりとりゲーム</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet"
    integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC" crossorigin="anonymous">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link
    href="https://fonts.googleapis.com/css2?family=M+PLUS+1:wght@100..900&family=Ubuntu+Sans:ital,wght@0,100..800;1,100..800&display=swap"
    rel="stylesheet">
  <style>
    body {
      font-family: "ubuntu sans", "M PLUS 1", sans-serif;
      letter-spacing: 0.05rem;
    }

    .bnto-head-sideline {
      display: flex;
      align-items: center;
      gap: 16px;
    }

    .bnto-head-sideline::before,
    .bnto-head-sideline::after {
      content: "";
      flex: 1;
      height: 2px;
      border-radius: 2px;
      background: hsl(30 12% 15%);
    }

    .info-msg {
      max-width: 25rem;
    }

    .bnto-user {
      position: fixed;
      top: 15px;
      right: 15px;
      z-index: 1000;

      --c1: lightgray;
      --dur: .15s;
      display: inline-block;
    }

    /* 丸アバターボタン */
    .bnto-user-btn {
      width: 46px;
      height: 46px;
      border-radius: 50%;
      border: 3px solid #fff;
      background: var(--c1);
      color: #fff;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      box-shadow: 0 5px 14px rgba(0, 0, 0, .16);
    }

    .bnto-user-menu {
      position: absolute;
      top: calc(100% + 10px);
      right: 0;
      min-width: 200px;
      z-index: 5;
      background: #fff;
      border: 2px solid #DFE9F1;
      border-radius: 12px;
      padding: 6px;
      box-shadow: 0 12px 28px rgba(0, 0, 0, .12);
      opacity: 0;
      visibility: hidden;
      transform: translateY(-6px);
      transition: opacity var(--dur), transform var(--dur), visibility var(--dur);
    }

    .bnto-user.is-open .bnto-user-menu {
      opacity: 1;
      visibility: visible;
      transform: none;
    }

    /* ユーザー情報ヘッダー */
    .bnto-user-menu .who {
      padding: 8px 12px 10px;
      border-bottom: 2px dashed #DFE9F1;
      margin-bottom: 4px;
    }

    .bnto-user-menu .who b {
      display: block;
    }

    .bnto-user-menu .who span {
      font-size: 11px;
      color: #9a948a;
    }

    .bnto-user-menu a {
      display: flex;
      align-items: center;
      gap: 9px;
      padding: 9px 12px;
      border-radius: 8px;
      color: inherit;
      text-decoration: none;
      font-weight: 700;
    }

    .bnto-user-menu a:hover {
      background: #EAF2F8;
    }

    .bnto-user-menu .sep {
      border-top: 2px dashed #DFE9F1;
      margin: 4px 0;
    }

    .bnto-user-menu .out {
      color: hsl(4 75% 52%);
    }

    .bnto-user-menu .out:hover {
      background: hsl(4 75% 96%);
    }
  </style>
</head>

<body>
  <h1 class="bnto-head-sideline mt-3 mb-5">しりとりゲーム</h1>
  <div class="bnto-user" data-bnto-usermenu>
    <button type="button" class="bnto-user-btn" aria-label="ユーザーメニュー">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"
        stroke-linecap="round" stroke-linejoin="round">
        <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2" />
        <circle cx="12" cy="7" r="4" />
      </svg>
    </button>
    <div class="bnto-user-menu">
      <div class="who"><b id="who"></b><span id="whoid"></span></div>
      <a href="/settings/profile">プロフィール</a>
      <a href="/status">ステータス</a>
      <div class="sep" role="separator"></div>
      <a href="/logout" class="out">ログアウト</a>
    </div>
  </div>
  <div class="text-center mt-3">
    <div class="d-flex flex-column align-items-center">

      <div class="alert alert-info info-msg">
        <span id="displayName"></span> さん、しりとりを始めましょう！
      </div>

      <h2 class="bnto-head-sideline mt-3 mb-2">ルール</h2>
      最後の文字が、<br>
      伸ばし棒の時は、直前の文字の母音から続けます。<br>
      小さい文字の時は、大きくします。<br>
      たとえば、<br>
      「かれー」の次は「え」から始まる単語です。<br>
      「かいしゃ」の次は「や」から始まる単語です。<br>
      <div>
        <button class="btn btn-success rounded-pill px-3 my-5 mx-3" id="gameBtn" autofocus disabled>CPU対戦</button>
        <button class="btn btn-secondary rounded-pill px-3 my-5 mx-3" id="pvp" autofocus disabled>Coming Soon…</button>
      </div>
    </div>

  </div>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.bundle.min.js"
    integrity="sha384-MrcW6ZMFYlzcLA8Nl+NtUVF0sA7MsXsP1UyJoMp4YLEuNSfAP+JcXn/tWtIaxVXM"
    crossorigin="anonymous"></script>
  <script>
    // elements
    const gameBtn = document.getElementById("gameBtn");
    const pvpBtn = document.getElementById("pvp");
    const nameDisplay = document.getElementById("displayName");

    window.addEventListener("DOMContentLoaded", async () => {
      const playerId = localStorage.getItem("pid") ?? undefined;
      if (!playerId){
        location.href="/";
        return
      }
      let pidFD = new FormData();
      pidFD.append("pid", playerId);

      const response = await fetch("/api/pid", {
        method: "POST",
        body: new URLSearchParams(pidFD)
      })
      const result = await response.json();
      if (!result.ok) {
        location.href = "/";
        return;
      }
      if (result.ok) {
        document.getElementById("who").textContent = result.player.displayName;
        document.getElementById("whoid").textContent = "@" + result.player.id;
        const userMenu = document.querySelector(".bnto-user");
        let theme = result.player.themeColor;
        userMenu.style.setProperty("--c1", theme);
        nameDisplay.textContent = result.player.displayName;

        gameBtn.onclick = () => {
          location.href = `/cpu?pid=${encodeURIComponent(playerId)}`;
        };
        pvpBtn.onclick = () => {
          location.href = `/rooms`;
        };
        gameBtn.disabled = false;
        pvpBtn.disabled = false;
        gameBtn.focus();
      }
    })

  </script>
  <script>
      // ユーザーメニュー：項目クリックでも閉じる
      (function () {
        document.querySelectorAll('[data-bnto-usermenu]').forEach(function (um) {
          if (um.dataset.bntoInit) return;
          um.dataset.bntoInit = '1';
          var btn = um.querySelector('.bnto-user-btn');
          btn.setAttribute('aria-haspopup', 'true');
          btn.setAttribute('aria-expanded', 'false');
          btn.addEventListener('click', function () {
            var open = um.classList.toggle('is-open');
            btn.setAttribute('aria-expanded', open);
          });
          um.querySelectorAll('.bnto-user-menu a').forEach(function (item) {
            item.addEventListener('click', function () {
              um.classList.remove('is-open');
              btn.setAttribute('aria-expanded', 'false');
            });
          });
        });
        // 外側クリック / Esc で閉じる（documentへの登録は1回だけ）
        if (document.documentElement.dataset.bntoUserDoc) return;
        document.documentElement.dataset.bntoUserDoc = '1';
        function closeAll(except) {
          document.querySelectorAll('[data-bnto-usermenu].is-open').forEach(function (um) {
            if (um === except) return;
            um.classList.remove('is-open');
            um.querySelector('.bnto-user-btn').setAttribute('aria-expanded', 'false');
          });
        }
        document.addEventListener('click', function (e) {
          closeAll(e.target.closest('[data-bnto-usermenu]'));
        });
        document.addEventListener('keydown', function (e) {
          if (e.key === 'Escape') closeAll(null);
        });
      })();
  </script>
</body>

</html>